{
  "name": "shopeefood-web",
  "version": "2.0.0",
  "description": "ShopeeFood Full-Stack Web App (Block #5 SSR + Block #6 REST API & SPA)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:api": "node src/server.js --api-only",
    "start:web": "node web/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "test": "node --test --test-concurrency=1 tests/app.test.js tests/block6.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "method-override": "^3.0.0",
    "pg": "^8.13.3"
  }
}
