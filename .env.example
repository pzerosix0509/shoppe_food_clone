# Port cho Backend REST API & SSR server
PORT=3000

# Port cho Frontend SPA server (Block #6)
WEB_PORT=5173

# Origin của SPA được phép gọi REST API qua CORS (không có dấu / ở cuối, không dùng *)
CORS_ORIGIN="http://localhost:5173"

# Mặc định dùng SQLite cục bộ để chạy ngay không cần cấu hình mạng:
DATABASE_URL="file:./data/shopeefood.db"

# Khi chuyển sang Supabase PostgreSQL (Session Pooler port 5432), đổi thành:
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
