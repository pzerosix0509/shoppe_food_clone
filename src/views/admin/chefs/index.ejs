<%- include('../../partials/admin-header', { pageTitle: 'Quản lý Đầu Bếp', activeTab: 'chefs' }) %>

<main class="container" style="padding-bottom: 60px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div>
      <h1 style="margin: 0; font-size: 1.55rem;">👨‍🍳 Quản lý Đầu Bếp (Chefs CRUD)</h1>
      <p style="margin: 4px 0 0; color: var(--sf-muted); font-size: 0.88rem;">Tổng cộng <%= chefs.length %> đầu bếp</p>
    </div>
    <a href="/admin/chefs/new" class="sf-btn sf-btn-primary">+ Thêm đầu bếp mới</a>
  </div>

  <div class="sf-card">
    <div class="sf-table-wrap">
      <table class="sf-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Đầu bếp</th>
            <th>Chuyên môn (Specialty)</th>
            <th>Kinh nghiệm</th>
            <th>Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% chefs.forEach(c => { %>
            <tr>
              <td><strong>#<%= c.id %></strong></td>
              <td>
                <div style="display: flex; align-items: center; gap: 10px;">
                  <img src="<%= c.avatarUrl %>" alt="<%= c.name %>" style="width: 42px; height: 42px; border-radius: 50%; object-fit: cover;" />
                  <a href="/admin/chefs/<%= c.id %>" style="font-weight: 700; color: var(--sf-primary);"><%= c.name %></a>
                </div>
              </td>
              <td><%= c.specialty %></td>
              <td><%= c.experience %> năm</td>
              <td>
                <div style="display: flex; gap: 8px;">
                  <a href="/admin/chefs/<%= c.id %>" class="sf-btn sf-btn-outline" style="padding: 5px 10px; font-size: 0.8rem;">Chi tiết</a>
                  <a href="/admin/chefs/<%= c.id %>/edit" class="sf-btn sf-btn-outline" style="padding: 5px 10px; font-size: 0.8rem;">Sửa</a>
                  <a href="/admin/chefs/<%= c.id %>/delete" class="sf-btn sf-btn-danger" style="padding: 5px 10px; font-size: 0.8rem;">Xóa</a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
