<%- include('../../partials/admin-header', { pageTitle: 'Xác nhận xóa Món #' + dish.id, activeTab: 'dishes' }) %>

<main class="container" style="max-width: 580px; padding-bottom: 60px;">
  <div class="sf-card" style="text-align: center; padding: 32px;">
    <div style="font-size: 3rem; margin-bottom: 8px;">⚠️</div>
    <h1 style="margin: 0 0 10px; font-size: 1.45rem;">Xác nhận xóa món ăn?</h1>
    <p style="color: var(--sf-muted); margin-bottom: 20px;">
      Bạn có chắc chắn muốn xóa vĩnh viễn món <strong>#<%= dish.id %> - <%= dish.name %></strong> (<%= formatVND(dish.price) %>) khỏi cơ sở dữ liệu?
    </p>

    <form method="POST" action="/admin/dishes/<%= dish.id %>?_method=DELETE" style="display: flex; justify-content: center; gap: 12px;">
      <button type="submit" class="sf-btn sf-btn-danger">Xác nhận Xóa (DELETE)</button>
      <a href="/admin/dishes/<%= dish.id %>" class="sf-btn sf-btn-outline">Hủy bỏ, quay lại</a>
    </form>
  </div>
</main>

<%- include('../../partials/footer') %>
