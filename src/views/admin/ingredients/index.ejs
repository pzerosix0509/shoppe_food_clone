<%- include('../../partials/admin-header', { pageTitle: 'Quản lý Nguyên Liệu', activeTab: 'ingredients' }) %>

<main class="container" style="padding-bottom: 60px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div>
      <h1 style="margin: 0; font-size: 1.55rem;">🥬 Quản lý Nguyên Liệu (Ingredients CRUD)</h1>
      <p style="margin: 4px 0 0; color: var(--sf-muted); font-size: 0.88rem;">Tổng cộng <%= ingredients.length %> nguyên liệu trong kho</p>
    </div>
    <a href="/admin/ingredients/new" class="sf-btn sf-btn-primary">+ Thêm nguyên liệu mới</a>
  </div>

  <div class="sf-card">
    <div class="sf-table-wrap">
      <table class="sf-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Tên nguyên liệu</th>
            <th>Đơn vị (Unit)</th>
            <th>Tồn kho</th>
            <th>Xuất xứ</th>
            <th>Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% ingredients.forEach(ing => { %>
            <tr>
              <td><strong>#<%= ing.id %></strong></td>
              <td>
                <a href="/admin/ingredients/<%= ing.id %>" style="font-weight: 700; color: var(--sf-primary);">
                  <%= ing.name %>
                </a>
              </td>
              <td><span class="sf-badge muted"><%= ing.unit %></span></td>
              <td><strong><%= ing.stock %></strong> <%= ing.unit %></td>
              <td><%= ing.origin %></td>
              <td>
                <div style="display: flex; gap: 8px;">
                  <a href="/admin/ingredients/<%= ing.id %>" class="sf-btn sf-btn-outline" style="padding: 5px 10px; font-size: 0.8rem;">Chi tiết</a>
                  <a href="/admin/ingredients/<%= ing.id %>/edit" class="sf-btn sf-btn-outline" style="padding: 5px 10px; font-size: 0.8rem;">Sửa</a>
                  <a href="/admin/ingredients/<%= ing.id %>/delete" class="sf-btn sf-btn-danger" style="padding: 5px 10px; font-size: 0.8rem;">Xóa</a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../../partials/footer') %>
