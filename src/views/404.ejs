<%- include('partials/header', { pageTitle: '404 Không Tìm Thấy' }) %>

<main class="container" style="padding: 64px 20px; text-align: center;">
  <div class="sf-card" style="max-width: 560px; margin: 0 auto; padding: 40px 28px;">
    <div style="font-size: 3.5rem; margin-bottom: 12px;">🍜</div>
    <span class="sf-badge muted" style="margin-bottom: 12px;">HTTP 404 NOT FOUND</span>
    <h1 style="margin: 8px 0 12px; font-size: 1.65rem;">Không tìm thấy nội dung</h1>
    <p style="color: var(--sf-muted); margin-bottom: 24px;">
      <%= typeof message !== 'undefined' ? message : 'Món ăn hoặc trang bạn yêu cầu không tồn tại hoặc đã bị xóa.' %>
    </p>
    <div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
      <a href="/dishes" class="sf-btn sf-btn-primary">← Quay về Thực đơn ShopeeFood</a>
      <a href="/admin" class="sf-btn sf-btn-outline">Trang Quản trị</a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
